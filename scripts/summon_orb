#!/usr/bin/env python3
"""Detects selected or copied files and summons Convert Orb via IPC."""

import json
import os
import subprocess
import sys
import time
import urllib.parse


def detect_selected_files():
    # 1. Check text/uri-list in clipboard
    try:
        out = subprocess.check_output(
            ["wl-paste", "-t", "text/uri-list"],
            stderr=subprocess.DEVNULL,
            timeout=0.2
        ).decode("utf-8", "ignore")
        lines = [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("#")]
        paths = [urllib.parse.unquote(l[7:]) for l in lines if l.startswith("file://")]
        valid = [p for p in paths if os.path.exists(p)]
        if valid:
            return valid
    except Exception:
        pass

    # 2. Check plain text clipboard for an existing file path
    try:
        out = subprocess.check_output(
            ["wl-paste"],
            stderr=subprocess.DEVNULL,
            timeout=0.2
        ).decode("utf-8", "ignore").strip()
        if os.path.exists(out) and os.path.isfile(out):
            return [out]
    except Exception:
        pass

    # 3. Try to copy selection from the focused window (Flea, Nautilus, Dolphin, etc.)
    try:
        subprocess.run(["wtype", "-M", "ctrl", "-k", "c", "-m", "ctrl"], check=False, timeout=0.3)
        time.sleep(0.06)
        out = subprocess.check_output(
            ["wl-paste", "-t", "text/uri-list"],
            stderr=subprocess.DEVNULL,
            timeout=0.2
        ).decode("utf-8", "ignore")
        lines = [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("#")]
        paths = [urllib.parse.unquote(l[7:]) for l in lines if l.startswith("file://")]
        valid = [p for p in paths if os.path.exists(p)]
        if valid:
            return valid
    except Exception:
        pass

    return []


def main():
    files = detect_selected_files()
    if files:
        payload = json.dumps({"files": files})
    else:
        payload = json.dumps({"openPicker": True})

    subprocess.run(["omarchy-shell", "shell", "summon", "dorneles.convert-orb", payload], check=False)


if __name__ == "__main__":
    main()
