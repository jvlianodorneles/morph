#!/usr/bin/env python3
"""Detects selected or copied files and summons Convert Orb via IPC."""

import json
import os
import subprocess
import sys
import time
import urllib.parse


def get_active_window_class():
    try:
        out = subprocess.check_output(
            ["hyprctl", "activewindow", "-j"],
            stderr=subprocess.DEVNULL,
            timeout=0.2
        ).decode("utf-8", "ignore")
        data = json.loads(out)
        return data.get("class", ""), data.get("initialClass", "")
    except Exception:
        return "", ""


def get_flea_selection():
    try:
        out = subprocess.check_output(
            ["qs", "ipc", "-n", "-p", "/usr/share/flea/ui/boot", "call", "flea", "providerState"],
            stderr=subprocess.DEVNULL,
            timeout=0.25
        ).decode("utf-8", "ignore")
        data = json.loads(out)
        selected = [p for p in (data.get("selectedPaths") or []) if p and os.path.isfile(p)]
        if selected:
            return selected
        cursor = data.get("cursorPath")
        if cursor and os.path.isfile(cursor):
            return [cursor]
    except Exception:
        pass
    return []


def read_clipboard_uris():
    # 1. Try text/uri-list
    try:
        out = subprocess.check_output(
            ["wl-paste", "-t", "text/uri-list"],
            stderr=subprocess.DEVNULL,
            timeout=0.25
        ).decode("utf-8", "ignore")
        lines = [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("#")]
        paths = [urllib.parse.unquote(l[7:]) for l in lines if l.startswith("file://")]
        valid = [p for p in paths if os.path.exists(p) and os.path.isfile(p)]
        if valid:
            return valid
    except Exception:
        pass

    # 2. Try GNOME/Nautilus copied files format (copy\nfile://...)
    try:
        out = subprocess.check_output(
            ["wl-paste", "-t", "x-special/gnome-copied-files"],
            stderr=subprocess.DEVNULL,
            timeout=0.25
        ).decode("utf-8", "ignore")
        lines = [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("#") and l != "copy" and l != "cut"]
        paths = [urllib.parse.unquote(l[7:]) for l in lines if l.startswith("file://")]
        valid = [p for p in paths if os.path.exists(p) and os.path.isfile(p)]
        if valid:
            return valid
    except Exception:
        pass

    return []


def detect_selected_files():
    cls, init_cls = get_active_window_class()

    # 1. If Flea is active, query Flea directly (fastest and most accurate)
    if "flea" in cls.lower() or "flea" in init_cls.lower():
        files = get_flea_selection()
        if files:
            return files

    # 2. Try copying current selection from active window (Nautilus, Dolphin, Thunar, etc.)
    # First clear the clipboard so we don't accidentally pick up an old stale file
    try:
        subprocess.run(["wl-copy", "--clear"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.05)
        subprocess.run(["wtype", "-M", "ctrl", "-s", "40", "-k", "c", "-s", "40", "-m", "ctrl"], check=False, timeout=0.35)
        time.sleep(0.15)
    except Exception:
        pass

    # Check if a newly selected file was copied into clipboard
    files = read_clipboard_uris()
    if files:
        return files

    # 3. Fallback: check plain text in clipboard in case user copied a filepath
    try:
        out = subprocess.check_output(
            ["wl-paste"],
            stderr=subprocess.DEVNULL,
            timeout=0.2
        ).decode("utf-8", "ignore").strip()
        if os.path.exists(out) and os.path.isfile(out):
            return [out]
    except Exception:
        pass

    return []


def main():
    files = detect_selected_files()
    if files:
        payload = json.dumps({"files": files})
    else:
        payload = json.dumps({"openPicker": True})

    subprocess.run(["omarchy-shell", "shell", "summon", "dorneles.convert-orb", payload], check=False)


if __name__ == "__main__":
    main()
