{
    "_WARNING_": "DO NOT EDIT THIS FILE! It will be overwritten on updates. To customize settings, edit user_settings.json in ~/.config/simplyconvertfile/",
    "version": "2.0.2",
    "auto_update_settings": false,
    "settings_check_interval_days": 7,
    "directory_creation_threshold": 5,
    "output_directory_name": "converted_files",
    "temporary": {
        "directory": "/tmp",
        "directory_prefix": "convert_file_",
        "file_prefix": "convert_file_",
        "file_suffix": ".tmp"
    },
    "allow_dangerous_commands": false,
    "use_canonical_formats": true,
    "notifications": {
        "enabled": true,
        "on_start": false,
        "on_success": true,
        "on_failure": true,
        "on_cancel": true,
        "on_batch_start": false,
        "on_batch_finish": true,
        "on_batch_cancel": true,
        "on_batch_step_start": false,
        "on_batch_step_success": false,
        "on_batch_step_failure": true,
        "on_missing_dependency": true,
        "on_settings_corrupted": true
    },
    "format_aliases": {
        "ALAC": "M4A",
        "DOC": "DOCX",
        "HTM": "HTML",
        "JPG": "JPEG",
        "MK3D": "MKV",
        "MPG": "MPEG",
        "M4V": "MP4",
        "PPT": "PPTX",
        "TIF": "TIFF",
        "XLS": "XLSX",
        "YML": "YAML"
    },
    "preselect_format_by_usage": true,
    "default_formats": {
        "IMAGE": [
            "PNG",
            "JPEG"
        ],
        "VIDEO": [
            "MP4",
            "MKV"
        ],
        "AUDIO": [
            "MP3",
            "AAC"
        ],
        "DOCUMENT": [
            "PDF",
            "DOCX"
        ],
        "OFFICE": [
            "PDF",
            "DOCX"
        ],
        "SPREADSHEET": [
            "XLSX",
            "CSV"
        ],
        "PRESENTATION": [
            "PPTX",
            "PDF"
        ],
        "MARKUP": [
            "HTML",
            "MD"
        ],
        "DATA": [
            "JSON",
            "TXT"
        ],
        "ARCHIVE": [
            "ZIP",
            "ISO"
        ]
    },
    "output_restricted_formats": [
        "ARW",
        "CR2",
        "DEB",
        "DMG",
        "DNG",
        "NEF",
        "ORF",
        "PEF",
        "RAF",
        "RAW",
        "RPM",
        "RW2",
        "SR2"
    ],
    "conversion_exclusions": [],
    "archive_rules": {
        "by_target": {
            "7Z": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "7z a -t7z -mx=9 '{output}' ."
            ],
            "ISO": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "genisoimage -o '{output}' -R -J -joliet-long '{temp_dir}'"
            ],
            "RAR": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "rar a -m5 '{output}' ."
            ],
            "TAR": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -cf '{output}' ."
            ],
            "TAR.BZ2": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -cjf '{output}' ."
            ],
            "TAR.GZ": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ],
            "TAR.LZMA": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -cf - . | lzma -c > '{output}'"
            ],
            "TAR.LZO": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -cf - . | lzop -c > '{output}'"
            ],
            "TAR.XZ": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -cJf '{output}' ."
            ],
            "TGZ": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ],
            "ZIP": [
                "7z x '{input}' -o'{temp_dir}/' -bb0",
                "cd '{temp_dir}'",
                "zip -r -9 '{output}' ."
            ]
        },
        "default": [
            "7z x '{input}' -o'{temp_dir}/' -bb0",
            "cd '{temp_dir}'",
            "7z a -mx=9 '{output}' ."
        ]
    },
    "audio_rules": {
        "by_target": {
            "AAC": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a aac -b:a 256k -ar 48000 '{output}'",
            "FLAC": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a flac -compression_level 8 '{output}'",
            "M4A": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a alac '{output}'",
            "MP3": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a libmp3lame -q:a 0 -id3v2_version 3 '{output}'",
            "OGG": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a libvorbis -q:a 8 -ar 48000 '{output}'",
            "OPUS": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -codec:a libopus -b:a 128k '{output}'",
            "WAV": "ffmpeg -i '{input}' -map 0:a -codec:a pcm_s16le -ar 44100 '{output}'"
        },
        "default": "ffmpeg -i '{input}' -map 0:a -map_metadata 0 -q:a 0 '{output}'"
    },
    "data_rules": {
        "by_target": {
            "JSON": "pandoc '{input}' -o '{output}' -t json",
            "TXT": "pandoc '{input}' -o '{output}' -t plain",
            "YAML": "pandoc '{input}' -o '{output}' -t markdown"
        },
        "default": "pandoc '{input}' -o '{output}'"
    },
    "image_rules": {
        "by_target": {
            "AVIF": "convert '{input}' -auto-orient -quality 90 -define heic:speed=4 '{output}'",
            "GIF": "convert '{input}' -auto-orient -colors 256 '{output}'",
            "ICO": "convert '{input}' -auto-orient -define icon:auto-resize=256,128,64,48,32,16 '{output}'",
            "JPEG": "convert '{input}' -auto-orient -quality 90 -sampling-factor 4:2:0 '{output}'",
            "PNG": "convert '{input}' -auto-orient -define png:compression-level=9 '{output}'",
            "TIFF": "convert '{input}' -auto-orient -compress lzw '{output}'",
            "WEBP": "convert '{input}' -auto-orient -quality 90 -define webp:method=6 '{output}'"
        },
        "default": "convert '{input}' -auto-orient '{output}'"
    },
    "markup_rules": {
        "by_target": {
            "HTML": "pandoc '{input}' -o '{output}' --standalone --self-contained --metadata title='Document'",
            "MD": "pandoc '{input}' -o '{output}' -t markdown --wrap=auto",
            "XML": "pandoc '{input}' -o '{output}' -t docbook"
        },
        "default": "pandoc '{input}' -o '{output}'"
    },
    "office_rules": {
        "by_target": {
            "DOCX": [
                "libreoffice --headless --convert-to docx --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.docx' '{output}'"
            ],
            "EPUB": "ebook-convert '{input}' '{output}' --enable-heuristics",
            "MOBI": "ebook-convert '{input}' '{output}' --enable-heuristics",
            "ODT": [
                "libreoffice --headless --convert-to odt --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.odt' '{output}'"
            ],
            "PDF": [
                "libreoffice --headless --convert-to pdf --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.pdf' '{output}'"
            ],
            "RTF": [
                "libreoffice --headless --convert-to rtf --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.rtf' '{output}'"
            ]
        },
        "default": [
            "libreoffice --headless --convert-to {format} --outdir '{temp_dir}' '{input}'",
            "mv '{temp_dir}/{input_stem}.{format}' '{output}'"
        ]
    },
    "presentation_rules": {
        "by_target": {
            "ODP": [
                "libreoffice --headless --convert-to odp --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.odp' '{output}'"
            ],
            "PPTX": [
                "libreoffice --headless --convert-to pptx --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.pptx' '{output}'"
            ]
        },
        "default": [
            "libreoffice --headless --convert-to {format} --outdir '{temp_dir}' '{input}'",
            "mv '{temp_dir}/{input_stem}.{format}' '{output}'"
        ]
    },
    "spreadsheet_rules": {
        "by_target": {
            "CSV": [
                "libreoffice --headless --convert-to csv --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.csv' '{output}'"
            ],
            "ODS": [
                "libreoffice --headless --convert-to ods --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.ods' '{output}'"
            ],
            "XLSX": [
                "libreoffice --headless --convert-to xlsx --outdir '{temp_dir}' '{input}'",
                "mv '{temp_dir}/{input_stem}.xlsx' '{output}'"
            ]
        },
        "default": [
            "libreoffice --headless --convert-to {format} --outdir '{temp_dir}' '{input}'",
            "mv '{temp_dir}/{input_stem}.{format}' '{output}'"
        ]
    },
    "video_rules": {
        "by_target": {
            "AVI": "ffmpeg -i '{input}' -codec:v mpeg4 -q:v 3 -codec:a libmp3lame -b:a 192k '{output}'",
            "FLV": "ffmpeg -i '{input}' -codec:v libx264 -crf 23 -codec:a aac -b:a 128k '{output}'",
            "MKV": "ffmpeg -i '{input}' -codec:v libx265 -crf 23 -preset medium -codec:a aac -b:a 192k '{output}'",
            "MOV": "ffmpeg -i '{input}' -codec:v libx264 -crf 20 -preset medium -codec:a aac -b:a 192k -movflags +faststart '{output}'",
            "MPEG": "ffmpeg -i '{input}' -codec:v mpeg2video -q:v 2 -codec:a mp2 -b:a 192k '{output}'",
            "MP4": "ffmpeg -i '{input}' -codec:v libx264 -crf 20 -preset medium -codec:a aac -b:a 192k -movflags +faststart '{output}'",
            "WEBM": "ffmpeg -i '{input}' -codec:v libvpx-vp9 -crf 24 -b:v 0 -codec:a libopus -b:a 128k '{output}'"
        },
        "default": "ffmpeg -i '{input}' -codec:v libx264 -crf 23 -preset medium -codec:a aac -b:a 192k '{output}'"
    },
    "special_rules": [
        {
            "_COMMENT_": "ARCHIVE"
        },
        {
            "from": "DEB",
            "to": "7Z",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "7z a -t7z -mx=9 '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "ISO",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "genisoimage -o '{output}' -R -J -joliet-long '{temp_dir}'"
            ]
        },
        {
            "from": "DEB",
            "to": "RAR",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "rar a -m5 '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "TAR",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "TAR.BZ2",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cjf '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "TAR.GZ",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "TAR.LZMA",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf - . | lzma -c > '{output}'"
            ]
        },
        {
            "from": "DEB",
            "to": "TAR.LZO",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf - . | lzop -c > '{output}'"
            ]
        },
        {
            "from": "DEB",
            "to": "TAR.XZ",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cJf '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "TGZ",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ]
        },
        {
            "from": "DEB",
            "to": "ZIP",
            "command": [
                "ar x '{input}' --output='{temp_dir}'",
                "cd '{temp_dir}'",
                "zip -r -9 '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "7Z",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "7z a -t7z -mx=9 '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "ISO",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "genisoimage -o '{output}' -R -J -joliet-long '{temp_dir}'"
            ]
        },
        {
            "from": "RPM",
            "to": "RAR",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "rar a -m5 '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "TAR",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "TAR.BZ2",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cjf '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "TAR.GZ",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "TAR.LZMA",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf - . | lzma -c > '{output}'"
            ]
        },
        {
            "from": "RPM",
            "to": "TAR.LZO",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cf - . | lzop -c > '{output}'"
            ]
        },
        {
            "from": "RPM",
            "to": "TAR.XZ",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -cJf '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "TGZ",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "tar -czf '{output}' ."
            ]
        },
        {
            "from": "RPM",
            "to": "ZIP",
            "command": [
                "rpm2cpio '{input}' | cpio -idmv -D '{temp_dir}'",
                "cd '{temp_dir}'",
                "zip -r -9 '{output}' ."
            ]
        },
        {
            "_COMMENT_": "AUDIO"
        },
        {
            "_COMMENT_": "DATA"
        },
        {
            "from": "JSON",
            "to": "TXT",
            "command": "/usr/bin/python3 -I '{python_helper}' json-to-txt -- '{input}' '{output}'"
        },
        {
            "from": "JSON",
            "to": "XML",
            "command": "/usr/bin/python3 -I '{python_helper}' json-to-xml -- '{input}' '{output}'"
        },
        {
            "from": "JSON",
            "to": "YAML",
            "command": "/usr/bin/python3 -I '{python_helper}' json-to-yaml -- '{input}' '{output}'"
        },
        {
            "from": "YAML",
            "to": "JSON",
            "command": "/usr/bin/python3 -I '{python_helper}' yaml-to-json -- '{input}' '{output}'"
        },
        {
            "from": "YAML",
            "to": "TXT",
            "command": "/usr/bin/python3 -I '{python_helper}' yaml-to-txt -- '{input}' '{output}'"
        },
        {
            "from": "YAML",
            "to": "XML",
            "command": "/usr/bin/python3 -I '{python_helper}' yaml-to-xml -- '{input}' '{output}'"
        },
        {
            "_COMMENT_": "IMAGE"
        },
        {
            "from": "SVG",
            "to": "JPEG",
            "command": "convert -background white -density 300 '{input}' -quality 90 '{output}'"
        },
        {
            "from": "SVG",
            "to": "PNG",
            "command": "convert -background none -density 300 '{input}' '{output}'"
        },
        {
            "from": "WEBP",
            "to": "GIF",
            "command": "convert '{input}' -coalesce '{output}'"
        },
        {
            "_COMMENT_": "MARKUP"
        },
        {
            "_COMMENT_": "OFFICE"
        },
        {
            "from": "EPUB",
            "to": "DOCX",
            "command": "pandoc '{input}' -o '{output}'"
        },
        {
            "from": "EPUB",
            "to": "PDF",
            "command": "ebook-convert '{input}' '{output}' --enable-heuristics --paper-size=a4"
        },
        {
            "from": "EPUB",
            "to": "RTF",
            "command": "pandoc '{input}' -o '{output}'"
        },
        {
            "from": "MOBI",
            "to": "DOCX",
            "command": [
                "ebook-convert '{input}' '{temp_file}.epub' --enable-heuristics",
                "pandoc '{temp_file}.epub' -o '{output}'"
            ],
            "temp_file_suffix": ".epub"
        },
        {
            "from": "MOBI",
            "to": "ODT",
            "command": [
                "ebook-convert '{input}' '{temp_file}.epub' --enable-heuristics",
                "pandoc '{temp_file}.epub' -o '{output}'"
            ],
            "temp_file_suffix": ".epub"
        },
        {
            "from": "MOBI",
            "to": "PDF",
            "command": "ebook-convert '{input}' '{output}' --enable-heuristics --paper-size=a4"
        },
        {
            "from": "MOBI",
            "to": "RTF",
            "command": [
                "ebook-convert '{input}' '{temp_file}' --enable-heuristics",
                "pandoc '{temp_file}' -o '{output}'"
            ]
        },
        {
            "_COMMENT_": "PRESENTATION"
        },
        {
            "_COMMENT_": "SPREADSHEET"
        },
        {
            "_COMMENT_": "VIDEO"
        },
        {
            "_COMMENT_": "IMAGE TO VIDEO"
        },
        {
            "from": "GIF",
            "to": "MP4",
            "command": "ffmpeg -i '{input}' -movflags faststart -pix_fmt yuv420p -vf 'scale=trunc(iw/2)*2:trunc(ih/2)*2' '{output}'"
        },
        {
            "from": "GIF",
            "to": "WEBM",
            "command": "ffmpeg -i '{input}' -c:v libvpx-vp9 -b:v 0 -crf 30 -vf 'scale=trunc(iw/2)*2:trunc(ih/2)*2' '{output}'"
        },
        {
            "_COMMENT_": "IMAGE TO OFFICE"
        },
        {
            "from": "JPEG",
            "to": "PDF",
            "command": "convert '{input}' '{output}'"
        },
        {
            "from": "PNG",
            "to": "PDF",
            "command": "convert '{input}' '{output}'"
        },
        {
            "_COMMENT_": "VIDEO TO IMAGE"
        },
        {
            "from": "AVI",
            "to": "GIF",
            "command": "ffmpeg -i '{input}' -vf 'fps=10,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5' '{output}'"
        },
        {
            "from": "MKV",
            "to": "GIF",
            "command": "ffmpeg -i '{input}' -vf 'fps=10,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5' '{output}'"
        },
        {
            "from": "MOV",
            "to": "GIF",
            "command": "ffmpeg -i '{input}' -vf 'fps=10,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5' '{output}'"
        },
        {
            "from": "MP4",
            "to": "GIF",
            "command": "ffmpeg -i '{input}' -vf 'fps=10,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5' '{output}'"
        },
        {
            "from": "WEBM",
            "to": "GIF",
            "command": "ffmpeg -i '{input}' -vf 'fps=10,scale=480:-1:flags=lanczos,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5' '{output}'"
        },
        {
            "_COMMENT_": "VIDEO TO AUDIO"
        },
        {
            "from": "AVI",
            "to": "MP3",
            "command": "ffmpeg -i '{input}' -vn -codec:a libmp3lame -q:a 0 '{output}'"
        },
        {
            "from": "MKV",
            "to": "MP3",
            "command": "ffmpeg -i '{input}' -vn -codec:a libmp3lame -q:a 0 '{output}'"
        },
        {
            "from": "MOV",
            "to": "MP3",
            "command": "ffmpeg -i '{input}' -vn -codec:a libmp3lame -q:a 0 '{output}'"
        },
        {
            "from": "MP4",
            "to": "MP3",
            "command": "ffmpeg -i '{input}' -vn -codec:a libmp3lame -q:a 0 '{output}'"
        },
        {
            "from": "WEBM",
            "to": "MP3",
            "command": "ffmpeg -i '{input}' -vn -codec:a libmp3lame -q:a 0 '{output}'"
        },
        {
